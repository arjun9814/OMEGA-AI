# GEMINI_API_KEY: Required for Gemini AI API calls and Gemini Live Voice mode.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional OpenRouter API key for fallback or OpenRouter chat.
OPENROUTER_API_KEY=

# NVIDIA_API_KEY: Optional NVIDIA API key for deepseek fallback chat.
NVIDIA_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
